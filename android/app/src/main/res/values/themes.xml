<resources>
    <style name="Theme.HermesAndroid" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/obsidian</item><item name="colorPrimaryDark">@color/obsidian</item>
        <item name="colorAccent">@color/gold</item><item name="android:colorAccent">@color/gold</item>
        <item name="android:windowBackground">@color/obsidian</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/obsidian</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/eb_garamond</item><item name="fontFamily">@font/eb_garamond</item>
        <item name="android:textColor">@color/gold_light</item><item name="android:textColorPrimary">@color/gold_light</item>
        <item name="android:textColorSecondary">@color/gold_muted</item><item name="android:textColorHint">@color/gold_muted</item>
        <item name="android:colorBackground">@color/obsidian</item><item name="buttonStyle">@style/Widget.Hermes.Button</item>
        <item name="editTextStyle">@style/Widget.Hermes.Input</item><item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Widget.Hermes.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/gold_button</item><item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item><item name="android:textColor">@color/gold_light</item>
        <item name="android:fontFamily">@font/cinzel</item><item name="fontFamily">@font/cinzel</item>
        <item name="android:textAllCaps">false</item><item name="android:textSize">13sp</item>
        <item name="android:minHeight">52dp</item><item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">8dp</item><item name="android:layout_marginBottom">4dp</item>
    </style>
    <style name="Widget.Hermes.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/gold_input</item><item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/gold_light</item><item name="android:textColorHint">@color/gold_muted</item>
        <item name="android:textSize">20sp</item><item name="android:padding">14dp</item><item name="android:minHeight">56dp</item>
    </style>
    <style name="Text.Hermes.Heading" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/cinzel</item><item name="android:textColor">@color/gold</item>
        <item name="android:textSize">23sp</item><item name="android:letterSpacing">0.06</item>
    </style>
</resources>